PORT=8787
# Log levels: debug, info, warn, error. Production default: info.
LOG_LEVEL=info
# Used by Vite when building the Electron client. Defaults to http://localhost:8787 when omitted.
VITE_FLOWCANVAS_GATEWAY_URL=https://flowcanvas-api.example.com
# Electron main-process request filter. Keep this identical to VITE_FLOWCANVAS_GATEWAY_URL.
FLOWCANVAS_GATEWAY_URL=https://flowcanvas-api.example.com

# OpenAI-compatible free upstream. Its Key stays on the gateway server.
FREE_UPSTREAM_URL=https://your-free-provider.example/v1
FREE_UPSTREAM_KEY=free-upstream-key
FREE_MODEL=free-model
# Maximum JSON request body for chat and image generation. Default: 2MB.
MAX_JSON_BODY_BYTES=2097152
# RavenHash hosts are hardcoded server-side to this whitelist. Each user supplies
# their own RavenHash API Key from FlowCanvas; no RavenHash Key is stored here.
# https://ai.ravenhash.org/v1 and https://art.ravenhash.org/v1
RAVENHASH_MODEL=ravenhash-model
RAVENHASH_IMAGE_MODEL=gpt-image-2
RAVENHASH_VIDEO_MODEL=ravenhash-video-model
# No-cost RavenHash endpoint used to validate a user Key before material upload.
RAVENHASH_KEY_VALIDATION_PATH=models
RAVENHASH_KEY_VALIDATION_TIMEOUT_MS=10000
RAVENHASH_KEY_VALIDATION_CACHE_MS=300000

# Optional free image/video upstream. Empty values fall back to FREE_UPSTREAM_URL/KEY/MODEL.
FREE_IMAGE_UPSTREAM_URL=
FREE_IMAGE_UPSTREAM_KEY=
FREE_IMAGE_MODEL=
FREE_VIDEO_MODEL=
MAX_MEDIA_UPLOAD_BYTES=536870912
MEDIA_DIR=./data/media
MEDIA_TTL_HOURS=24
MEDIA_UPLOAD_RATE_LIMIT_PER_HOUR=20
# Public HTTPS address used in returned material URLs.
PUBLIC_MEDIA_BASE_URL=https://flowcanvas-api.example.com
UPSTREAM_TIMEOUT_MS=120000

# Comma-separated browser origins. Native clients without Origin are also accepted.
CORS_ALLOWED_ORIGINS=http://localhost:5180,file://,null
# Set to loopback or the trusted reverse-proxy range when deployed behind a proxy.
TRUST_PROXY=
