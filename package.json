{
    "name": "flow-canvas",
    "version": "1.5.0-beta.1",
    "description": "本地素材管理、无限画布与 AI 图片/视频创作桌面应用",
    "main": "electron-main/main.js",
    "scripts": {
        "dev": "vite",
        "test": "node scripts/run-tests.cjs",
        "sync:prompt-pack": "node scripts/sync-awesome-prompt-pack.mjs",
        "build": "vite build",
        "mcp": "node mcp/flow-canvas-mcp.mjs",
        "electron:dev": "concurrently \"vite --host 127.0.0.1 --port 15321\" \"wait-on http://127.0.0.1:15321 && electron .\"",
        "electron:build": "vite build && electron-builder",
        "electron:build:mac": "vite build && electron-builder --mac",
        "test:agent:smoke": "node scripts/agent-smoke.cjs"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "ajv": "^6.15.0",
        "chokidar": "^3.6.0",
        "gsap": "^3.15.0",
        "konva": "^9.3.6",
        "sharp": "^0.33.2"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "electron": "^28.3.3",
        "electron-builder": "^26.0.12",
        "vite": "^5.4.0",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "org.ravenhash.flowcanvas",
        "productName": "Flow Canvas",
        "asar": true,
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron-main/**/*",
            "shared/**/*",
            "src/{package.json,board-transaction.js,graph-model.js,node-types.js,generator-result-stack.js,image-node-settings.js,image-intent-pipeline.js,provider-capabilities.js}",
            "mcp/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "mac": {
            "category": "public.app-category.graphics-design",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "artifactName": "Flow.Canvas.${version}.mac.${arch}.${ext}",
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "extendInfo": {
                "NSDesktopFolderUsageDescription": "Flow Canvas needs access to folders you choose for managing local media.",
                "NSDocumentsFolderUsageDescription": "Flow Canvas needs access to folders you choose for managing local media.",
                "NSDownloadsFolderUsageDescription": "Flow Canvas needs access to downloads you choose to import."
            }
        },
        "nsis": {
            "artifactName": "Flow.Canvas.Setup.${version}.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "portable": {
            "artifactName": "Flow.Canvas.${version}.${ext}"
        }
    }
}
