{
    "name": "flow-canvas",
    "version": "1.0.0",
    "description": "本地素材管理、无限画布与 AI 图片/视频创作桌面应用",
    "main": "electron-main/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "mcp": "node mcp/flow-canvas-mcp.mjs",
        "electron:dev": "concurrently \"vite --host 127.0.0.1 --port 15321\" \"wait-on http://127.0.0.1:15321 && electron .\"",
        "electron:build": "vite build && electron-builder"
    },
    "dependencies": {
        "chokidar": "^3.6.0",
        "gsap": "^3.15.0",
        "konva": "^9.3.6",
        "sharp": "^0.33.2"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "electron": "^28.3.3",
        "electron-builder": "^26.0.12",
        "vite": "^5.4.0",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "org.ravenhash.flowcanvas",
        "productName": "Flow Canvas",
        "asar": true,
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron-main/**/*",
            "shared/**/*",
            "mcp/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    }
}
